---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { optimizeImage } from '../../utils/cloudinary';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const allNews = (await getCollection('noticias'))
  .filter((item) => item.id !== article.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const formattedDate = article.data.pubDate.toLocaleDateString('es-EC', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const categorySlug = article.data.category
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '');

const articleUrl = new URL(Astro.url.pathname, Astro.site || 'https://infoazuay.net').toString();
const encodedTitle = encodeURIComponent(article.data.title);
const encodedUrl = encodeURIComponent(articleUrl);
const summaryText = article.data.subtitle || article.data.excerpt || '';
const heroImage = optimizeImage(article.data.image, 1200);
---

<BaseLayout
  title={article.data.title}
  description={summaryText}
  image={article.data.image}
  article={true}
  publishedTime={article.data.pubDate.toISOString()}
  author={article.data.author}
  category={article.data.category}
>
  <div class="container td-post-container">
    <div class="td-post-layout">
      <!-- Article Main Column -->
      <article class="td-post-main">
        <!-- Breadcrumb & Category -->
        <div class="td-post-crumbs">
          <a href="/" class="td-post-crumbs__link">Inicio</a>
          <span class="td-post-crumbs__sep">/</span>
          <a href={`/categoria/${categorySlug}`} class="td-cat-badge">
            {article.data.category}
          </a>
        </div>

        <!-- Title & Subtitle -->
        <h1 class="td-post-title">{article.data.title}</h1>
        {summaryText && (
          <p class="td-post-subtitle">{summaryText}</p>
        )}

        <!-- Author & Date Meta -->
        <div class="td-post-meta">
          <div class="td-post-meta__author">
            <span class="td-post-meta__by">Por</span>
            <strong>{article.data.author}</strong>
          </div>
          <span class="td-post-meta__dot">·</span>
          <time datetime={article.data.pubDate.toISOString()}>{formattedDate}</time>
          <span class="td-post-meta__dot">·</span>
          <span>{article.data.readTime} de lectura</span>
        </div>

        <!-- Share Buttons -->
        <div class="td-post-share">
          <span class="td-post-share__label">Compartir:</span>
          <a
            href={`https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="td-share-btn td-share-btn--wa"
            aria-label="Compartir en WhatsApp"
          >
            WhatsApp
          </a>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="td-share-btn td-share-btn--x"
            aria-label="Compartir en X"
          >
            X (Twitter)
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="td-share-btn td-share-btn--fb"
            aria-label="Compartir en Facebook"
          >
            Facebook
          </a>
        </div>

        <!-- Hero Image -->
        <figure class="td-post-figure">
          <img
            src={heroImage}
            alt={article.data.title}
            class="td-post-figure__img"
            loading="eager"
          />
          {article.data.imageCaption && (
            <figcaption class="td-post-figure__caption">
              {article.data.imageCaption}
            </figcaption>
          )}
        </figure>

        <!-- Post Body -->
        <div class="td-post-body">
          <Content />
        </div>

        <!-- Tags -->
        {article.data.tags && article.data.tags.length > 0 && (
          <div class="td-post-tags">
            <span class="td-post-tags__label">Etiquetas:</span>
            {article.data.tags.map((tag: string) => (
              <span class="td-post-tag">#{tag}</span>
            ))}
          </div>
        )}
      </article>

      <!-- Sidebar -->
      <aside class="td-post-sidebar">
        <div class="td-block-header td-block-header--red">
          <span class="td-block-title">Noticias Relacionadas</span>
        </div>
        <div class="td-sidebar-related">
          {allNews.map((rel) => (
            <NewsCard article={rel} variant="horizontal" />
          ))}
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .td-post-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .td-post-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 980px) {
    .td-post-layout {
      grid-template-columns: 1fr 340px;
    }
  }

  .td-post-main {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 1.75rem;
  }

  @media (min-width: 640px) {
    .td-post-main {
      padding: 2.5rem;
    }
  }

  .td-post-crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    margin-bottom: 1rem;
  }

  .td-post-crumbs__link:hover {
    color: var(--color-accent-red);
  }

  .td-post-crumbs__sep {
    color: #D1D5DB;
  }

  .td-post-title {
    font-family: var(--font-heading);
    font-size: 1.85rem;
    font-weight: 900;
    line-height: 1.25;
    color: var(--color-ink);
    margin-bottom: 0.75rem;
  }

  @media (min-width: 768px) {
    .td-post-title {
      font-size: 2.35rem;
    }
  }

  .td-post-subtitle {
    font-size: 1.08rem;
    line-height: 1.55;
    color: var(--color-ink-secondary);
    margin-bottom: 1.25rem;
  }

  .td-post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    padding-block: 0.75rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
  }

  .td-post-meta__by {
    color: var(--color-ink-muted);
    margin-right: 0.25rem;
  }

  .td-post-meta__author strong {
    color: var(--color-ink);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .td-post-meta__dot {
    opacity: 0.5;
  }

  /* Share Buttons */
  .td-post-share {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .td-post-share__label {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .td-share-btn {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 3px;
    color: #FFFFFF;
    transition: opacity 0.15s ease;
  }

  .td-share-btn:hover {
    opacity: 0.9;
    color: #FFFFFF;
  }

  .td-share-btn--wa {
    background: #25D366;
  }

  .td-share-btn--x {
    background: #000000;
  }

  .td-share-btn--fb {
    background: #1877F2;
  }

  /* Hero Figure */
  .td-post-figure {
    margin-bottom: 2rem;
  }

  .td-post-figure__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
  }

  .td-post-figure__caption {
    font-size: 0.78rem;
    color: var(--color-ink-muted);
    padding-top: 0.5rem;
    text-align: right;
  }

  /* Post Body */
  .td-post-body {
    font-family: var(--font-body);
    font-size: 1.08rem;
    line-height: 1.8;
    color: #1F2937;
  }

  .td-post-body :global(p) {
    margin-bottom: 1.35rem;
  }

  .td-post-body :global(h2), .td-post-body :global(h3) {
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .td-post-body :global(h2) {
    font-size: 1.45rem;
    border-left: 3px solid var(--color-accent-red);
    padding-left: 0.75rem;
  }

  .td-post-body :global(ul), .td-post-body :global(ol) {
    margin-bottom: 1.35rem;
    padding-left: 1.5rem;
  }

  .td-post-body :global(li) {
    margin-bottom: 0.45rem;
  }

  .td-post-body :global(blockquote) {
    border-left: 4px solid var(--color-accent-red);
    background: #F9FAFB;
    padding: 1.15rem 1.35rem;
    margin-block: 1.5rem;
    font-style: italic;
    font-size: 1.12rem;
    color: var(--color-ink);
  }

  /* Tags */
  .td-post-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .td-post-tags__label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-ink-muted);
  }

  .td-post-tag {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    background: #F3F4F6;
    color: var(--color-ink-secondary);
    padding: 0.25rem 0.65rem;
    border-radius: 2px;
  }

  /* Sidebar */
  .td-sidebar-related {
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.5rem 1rem;
  }
</style>
