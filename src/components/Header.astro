---
const categories = [
  { name: 'Inicio', href: '/' },
  { name: 'Cuenca', href: '/categoria/cuenca' },
  { name: 'Seguridad', href: '/categoria/seguridad' },
  { name: 'Movilidad', href: '/categoria/movilidad' },
  { name: 'Comunidad', href: '/categoria/comunidad' },
  { name: 'Opinión', href: '/categoria/opinion' },
];

const currentPath = Astro.url.pathname;

// Formatear fecha actual en español
const now = new Date();
const dateStr = now.toLocaleDateString('es-EC', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const capitalizedDate = dateStr.charAt(0).toUpperCase() + dateStr.slice(1);
---

<header class="td-header">
  <!-- Top Bar: Trending Ticker + Date + Weather -->
  <div class="td-topbar">
    <div class="container td-topbar__inner">
      <div class="td-trending">
        <span class="td-trending__badge">
          <span class="live-pulse"></span>
          TENDENCIA
        </span>
        <div class="td-trending__slider">
          <a href="/noticias/2026-11-11-operativo-rayo-austral-desarticulan-banda-vehicular-cuenca" class="td-trending__link">
            Operativo 'Rayo Austral': Desarticulan banda dedicada al robo de vehículos en Cuenca
          </a>
        </div>
      </div>

      <div class="td-topbar__meta">
        <span class="td-topbar__date">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
            <line x1="16" x2="16" y1="2" y2="6"/>
            <line x1="8" x2="8" y1="2" y2="6"/>
            <line x1="3" x2="21" y1="10" y2="10"/>
          </svg>
          {capitalizedDate}
        </span>
        <span class="td-topbar__weather">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2"/>
            <path d="M12 20v2"/>
            <path d="m4.93 4.93 1.41 1.41"/>
            <path d="m17.66 17.66 1.41 1.41"/>
            <path d="M2 12h2"/>
            <path d="M20 12h2"/>
            <path d="m6.34 17.66-1.41 1.41"/>
            <path d="m19.07 4.93-1.41 1.41"/>
          </svg>
          Cuenca 18°C · Parcialmente nublado
        </span>
      </div>
    </div>
  </div>

  <!-- Main Header: Logo + Banner -->
  <div class="td-main-header">
    <div class="container td-main-header__inner">
      <a href="/" class="td-brand" aria-label="Info Azuay - Inicio">
        <img
          src="/logo-info-azuay.png"
          alt="Info Azuay"
          class="td-brand__logo"
          width="240"
          height="160"
        />
        <div class="td-brand__text">
          <span class="td-brand__title">INFO <strong>AZUAY</strong></span>
          <span class="td-brand__tagline">El pulso informativo del Austro ecuatoriano</span>
        </div>
      </a>

      <div class="td-header-banner">
        <div class="td-live-status-pill">
          <span class="td-live-status-pill__label">EN VIVO</span>
          <span class="td-live-status-pill__text">Monitoreo vial y de seguridad 24/7 en Azuay</span>
        </div>
        <a href="https://central.neuronamedios.com" target="_blank" rel="noopener noreferrer" class="td-redaction-btn">
          <span>Sala de Redacción</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" x2="21" y1="14" y2="3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Nav Bar: Newspaper Dark Menu with Red Accents -->
  <nav class="td-navbar">
    <div class="container td-navbar__inner">
      <ul class="td-navbar__menu">
        {categories.map((cat) => {
          const isActive =
            cat.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(cat.href);
          return (
            <li class="td-navbar__item">
              <a
                href={cat.href}
                class:list={['td-navbar__link', { 'td-navbar__link--active': isActive }]}
              >
                {cat.name}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="td-navbar__actions">
        <button
          type="button"
          id="open-search-btn"
          class="td-search-btn"
          aria-label="Buscar noticias"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>Buscar</span>
        </button>
      </div>
    </div>
  </nav>
</header>

<!-- Modal Buscador Instantáneo -->
<div id="search-modal" class="search-modal" aria-hidden="true">
  <div class="search-modal__backdrop" id="close-search-backdrop"></div>
  <div class="search-modal__dialog" role="dialog" aria-modal="true" aria-label="Buscador de noticias">
    <div class="search-modal__header">
      <div class="search-input-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="search-input"
          placeholder="Buscar en Info Azuay..."
          autocomplete="off"
        />
      </div>
      <button type="button" id="close-search-btn" class="search-modal__close" aria-label="Cerrar buscador">
        ESC
      </button>
    </div>
    <div id="search-results" class="search-modal__results">
      <p class="search-modal__hint">Escribe al menos 2 letras para filtrar noticias.</p>
    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('open-search-btn');
  const closeBtn = document.getElementById('close-search-btn');
  const backdrop = document.getElementById('close-search-backdrop');
  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const resultsContainer = document.getElementById('search-results');

  let articlesCache: any[] | null = null;

  async function loadSearchIndex() {
    if (articlesCache) return articlesCache;
    try {
      const res = await fetch('/api/search.json');
      articlesCache = await res.json();
      return articlesCache;
    } catch {
      return [];
    }
  }

  function openSearch() {
    modal?.classList.add('is-open');
    modal?.setAttribute('aria-hidden', 'false');
    setTimeout(() => input?.focus(), 50);
    loadSearchIndex();
  }

  function closeSearch() {
    modal?.classList.remove('is-open');
    modal?.setAttribute('aria-hidden', 'true');
  }

  openBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);
  backdrop?.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
      closeSearch();
    }
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  input?.addEventListener('input', async () => {
    const q = input.value.trim().toLowerCase();
    if (!resultsContainer) return;

    if (q.length < 2) {
      resultsContainer.innerHTML = '<p class="search-modal__hint">Escribe al menos 2 letras para filtrar noticias.</p>';
      return;
    }

    const data = await loadSearchIndex();
    const hits = data.filter((item: any) =>
      item.title.toLowerCase().includes(q) ||
      (item.subtitle && item.subtitle.toLowerCase().includes(q)) ||
      (item.category && item.category.toLowerCase().includes(q))
    ).slice(0, 7);

    if (hits.length === 0) {
      resultsContainer.innerHTML = `<p class="search-modal__hint">No encontramos noticias con "${q}".</p>`;
      return;
    }

    resultsContainer.innerHTML = hits.map((hit: any) => `
      <a href="/noticias/${hit.slug}" class="search-result-item">
        <span class="search-result-item__cat">${hit.category}</span>
        <h4 class="search-result-item__title">${hit.title}</h4>
        ${hit.subtitle ? `<p class="search-result-item__sub">${hit.subtitle}</p>` : ''}
      </a>
    `).join('');
  });
</script>

<style>
  .td-header {
    background: #FFFFFF;
    border-bottom: 2px solid var(--color-accent-red);
  }

  /* Top Bar */
  .td-topbar {
    background: var(--color-dark-bg);
    color: #CCCCCC;
    font-size: 0.74rem;
    border-bottom: 1px solid var(--color-dark-gray);
    padding-block: 0.45rem;
  }

  .td-topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .td-trending {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
  }

  .td-trending__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-accent-red);
    color: #FFFFFF;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .td-trending__link {
    color: #EEEEEE;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    max-width: 520px;
  }

  .td-trending__link:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  .td-topbar__meta {
    display: none;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
    font-size: 0.72rem;
  }

  .td-topbar__date, .td-topbar__weather {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  @media (min-width: 860px) {
    .td-topbar__meta {
      display: flex;
    }
  }

  /* Main Header Area */
  .td-main-header {
    padding-block: 1.25rem;
    background: #FFFFFF;
  }

  .td-main-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .td-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .td-brand__logo {
    height: 52px;
    width: auto;
    object-fit: contain;
  }

  .td-brand__text {
    display: flex;
    flex-direction: column;
  }

  .td-brand__title {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--color-dark-bg);
    line-height: 1;
  }

  .td-brand__title strong {
    color: var(--color-accent-red);
  }

  .td-brand__tagline {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    margin-top: 0.25rem;
  }

  .td-header-banner {
    display: none;
    align-items: center;
    gap: 1.25rem;
  }

  .td-live-status-pill {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    padding: 0.4rem 0.85rem;
    font-size: 0.78rem;
  }

  .td-live-status-pill__label {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.65rem;
    background: #111111;
    color: #FFFFFF;
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
  }

  .td-live-status-pill__text {
    color: var(--color-ink-secondary);
    font-weight: 500;
  }

  .td-redaction-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--color-accent-red);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.6rem 1.15rem;
    border-radius: 3px;
    transition: background 0.15s ease;
  }

  .td-redaction-btn:hover {
    background: var(--color-accent-red-hover);
    color: #FFFFFF;
  }

  @media (min-width: 900px) {
    .td-header-banner {
      display: flex;
    }
  }

  /* Main Navigation Bar (Today News Pro Style) */
  .td-navbar {
    background: var(--color-dark-bg);
    color: #FFFFFF;
    border-top: 1px solid var(--color-border-dark);
  }

  .td-navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .td-navbar__menu {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .td-navbar__menu::-webkit-scrollbar {
    display: none;
  }

  .td-navbar__item {
    flex-shrink: 0;
  }

  .td-navbar__link {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #FFFFFF;
    padding: 0.95rem 1.1rem;
    position: relative;
    transition: all 0.15s ease;
  }

  .td-navbar__link:hover {
    background: #1F1F1F;
    color: var(--color-accent-red);
  }

  .td-navbar__link--active {
    background: var(--color-accent-red);
    color: #FFFFFF;
  }

  .td-navbar__link--active:hover {
    background: var(--color-accent-red-hover);
    color: #FFFFFF;
  }

  .td-navbar__actions {
    margin-left: 1rem;
    flex-shrink: 0;
  }

  .td-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #222222;
    border: none;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.45rem 0.85rem;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .td-search-btn:hover {
    background: var(--color-accent-red);
  }

  /* Search Modal */
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 4rem 1rem 1rem;
  }

  .search-modal.is-open {
    display: flex;
  }

  .search-modal__backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }

  .search-modal__dialog {
    position: relative;
    z-index: 1;
    inline-size: 100%;
    max-inline-size: 640px;
    background: #FFFFFF;
    border-radius: 6px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
    border: 2px solid var(--color-accent-red);
    overflow: hidden;
  }

  .search-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    gap: 0.75rem;
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: 1;
    color: var(--color-accent-red);
  }

  .search-input-wrap input {
    inline-size: 100%;
    border: none;
    outline: none;
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-ink);
    background: transparent;
  }

  .search-modal__close {
    background: #F3F4F6;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 0.25rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 800;
    color: #4B5563;
    cursor: pointer;
  }

  .search-modal__results {
    max-block-size: 65dvh;
    overflow-y: auto;
    padding: 0.75rem 1.25rem 1.25rem;
  }

  .search-modal__hint {
    font-size: 0.88rem;
    color: var(--color-ink-muted);
    padding: 1rem 0;
    text-align: center;
  }

  :global(.search-result-item) {
    display: block;
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    border-radius: 4px;
  }

  :global(.search-result-item:hover) {
    background: #F9FAFB;
  }

  :global(.search-result-item__cat) {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-red);
  }

  :global(.search-result-item__title) {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0.15rem 0 0.25rem;
  }

  :global(.search-result-item__sub) {
    font-size: 0.82rem;
    color: var(--color-ink-secondary);
  }
</style>
