---
interface Props {
  article: any;
  variant?: 'hero-main' | 'hero-sub' | 'horizontal' | 'sidebar-ranked';
  rank?: number;
}

const { article, variant = 'horizontal', rank } = Astro.props;
const { title, subtitle, excerpt, category, author, pubDate, image, imageCaption, readTime } = article.data;
const slug = article.id || article.slug;

const dateFormatted = new Date(pubDate).toLocaleDateString('es-EC', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

{variant === 'hero-main' && (
  <article class="td-card-hero-main">
    <a href={`/noticias/${slug}`} class="td-card-hero-main__img-wrap">
      <img src={image} alt={title} class="td-card-hero-main__img" loading="eager" />
      <div class="td-card-hero-main__overlay"></div>
    </a>
    <div class="td-card-hero-main__content">
      <a href={`/categoria/${category.toLowerCase()}`} class="td-cat-badge">
        {category}
      </a>
      <h2 class="td-card-hero-main__title">
        <a href={`/noticias/${slug}`}>{title}</a>
      </h2>
      <div class="td-card-meta">
        <span class="td-card-meta__author">{author}</span>
        <span class="td-card-meta__dot">·</span>
        <time datetime={pubDate.toISOString()}>{dateFormatted}</time>
        <span class="td-card-meta__dot">·</span>
        <span>{readTime}</span>
      </div>
    </div>
  </article>
)}

{variant === 'hero-sub' && (
  <article class="td-card-hero-sub">
    <a href={`/noticias/${slug}`} class="td-card-hero-sub__img-wrap">
      <img src={image} alt={title} class="td-card-hero-sub__img" loading="lazy" />
      <div class="td-card-hero-sub__overlay"></div>
    </a>
    <div class="td-card-hero-sub__content">
      <a href={`/categoria/${category.toLowerCase()}`} class="td-cat-badge">
        {category}
      </a>
      <h3 class="td-card-hero-sub__title">
        <a href={`/noticias/${slug}`}>{title}</a>
      </h3>
      <div class="td-card-meta td-card-meta--light">
        <time datetime={pubDate.toISOString()}>{dateFormatted}</time>
      </div>
    </div>
  </article>
)}

{variant === 'horizontal' && (
  <article class="td-card-horizontal">
    <a href={`/noticias/${slug}`} class="td-card-horizontal__img-wrap">
      <img src={image} alt={title} class="td-card-horizontal__img" loading="lazy" />
      <span class="td-cat-badge td-card-horizontal__cat-badge">{category}</span>
    </a>
    <div class="td-card-horizontal__body">
      <h3 class="td-card-horizontal__title">
        <a href={`/noticias/${slug}`}>{title}</a>
      </h3>
      <p class="td-card-horizontal__excerpt">
        {subtitle || excerpt}
      </p>
      <div class="td-card-meta">
        <span class="td-card-meta__author">{author}</span>
        <span class="td-card-meta__dot">·</span>
        <time datetime={pubDate.toISOString()}>{dateFormatted}</time>
        <span class="td-card-meta__dot">·</span>
        <span>{readTime}</span>
      </div>
    </div>
  </article>
)}

{variant === 'sidebar-ranked' && (
  <article class="td-card-ranked">
    {rank && (
      <span class="td-card-ranked__num">{rank.toString().padStart(2, '0')}</span>
    )}
    <div class="td-card-ranked__body">
      <span class="td-card-ranked__cat">{category}</span>
      <h4 class="td-card-ranked__title">
        <a href={`/noticias/${slug}`}>{title}</a>
      </h4>
      <time class="td-card-ranked__date" datetime={pubDate.toISOString()}>
        {dateFormatted}
      </time>
    </div>
  </article>
)}

<style>
  /* Common Meta */
  .td-card-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .td-card-meta--light {
    color: rgba(255, 255, 255, 0.75);
  }

  .td-card-meta__author {
    color: var(--color-ink-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .td-card-meta__dot {
    opacity: 0.5;
  }

  /* Hero Main (Newspaper Big Grid Lead) */
  .td-card-hero-main {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    height: 100%;
    min-height: 420px;
    background: #000000;
  }

  .td-card-hero-main__img-wrap {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .td-card-hero-main__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .td-card-hero-main:hover .td-card-hero-main__img {
    transform: scale(1.03);
  }

  .td-card-hero-main__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.92) 100%);
  }

  .td-card-hero-main__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.75rem 1.5rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .td-card-hero-main__title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.25;
    color: #FFFFFF;
  }

  .td-card-hero-main__title a:hover {
    color: #F87171;
  }

  /* Hero Sub (Newspaper 2x2 side grid) */
  .td-card-hero-sub {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    height: 200px;
    background: #000000;
  }

  .td-card-hero-sub__img-wrap {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .td-card-hero-sub__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .td-card-hero-sub:hover .td-card-hero-sub__img {
    transform: scale(1.04);
  }

  .td-card-hero-sub__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 20%, rgba(0,0,0,0.88) 100%);
  }

  .td-card-hero-sub__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.95rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .td-card-hero-sub__title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    color: #FFFFFF;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .td-card-hero-sub__title a:hover {
    color: #F87171;
  }

  /* Horizontal List Item */
  .td-card-horizontal {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background: transparent;
  }

  .td-card-horizontal__img-wrap {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    overflow: hidden;
    flex-shrink: 0;
    background: #E5E7EB;
  }

  .td-card-horizontal__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .td-card-horizontal:hover .td-card-horizontal__img {
    transform: scale(1.03);
  }

  .td-card-horizontal__cat-badge {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    z-index: 2;
  }

  .td-card-horizontal__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .td-card-horizontal__title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .td-card-horizontal__title a:hover {
    color: var(--color-accent-red);
  }

  .td-card-horizontal__excerpt {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-ink-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .td-card-horizontal {
      flex-direction: row;
      align-items: center;
    }

    .td-card-horizontal__img-wrap {
      width: 240px;
    }
  }

  /* Sidebar Ranked Item with Big Numbers */
  .td-card-ranked {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--color-border);
  }

  .td-card-ranked:last-child {
    border-bottom: none;
  }

  .td-card-ranked__num {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 900;
    color: #E2E8F0;
    line-height: 1;
    min-width: 2.2rem;
    letter-spacing: -0.04em;
  }

  .td-card-ranked:hover .td-card-ranked__num {
    color: var(--color-accent-red);
  }

  .td-card-ranked__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .td-card-ranked__cat {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-accent-red);
    letter-spacing: 0.05em;
  }

  .td-card-ranked__title {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-ink);
  }

  .td-card-ranked__title a:hover {
    color: var(--color-accent-red);
  }

  .td-card-ranked__date {
    font-size: 0.72rem;
    color: var(--color-ink-muted);
  }
</style>
